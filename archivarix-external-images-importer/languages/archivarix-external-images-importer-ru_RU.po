msgstr "Изображение удалено из записи"

#: ../archivarix-external-images-importer.php:797
msgid "Image is being processed by another request"
msgstr "Изображение обрабатывается другим запросом"

#. translators: %s: download source name (e.g., "Original", "Web Archive")
#: ../archivarix-external-images-importer.php:842, ../archivarix-external-images-importer.php:1175
msgid "Downloaded from %s"
msgstr "Скачано из %s"

#: ../archivarix-external-images-importer.php:888, ../archivarix-external-images-importer.php:898
msgid "Used previously downloaded image"
msgstr "Использовано ранее скачанное изображение"

#: ../archivarix-external-images-importer.php:917
msgid "Previously failed, skipped"
msgstr "Ранее не удалось, пропущено"

#: ../archivarix-external-images-importer.php:1078
msgid "Could not download from any source"
msgstr "Не удалось скачать ни из одного источника"

#: ../archivarix-external-images-importer.php:1107
msgid "Used existing file from media library"
msgstr "Использован существующий файл из медиабиблиотеки"

#: ../archivarix-external-images-importer.php:1125
msgid "Could not save file"
msgstr "Не удалось сохранить файл"

#: ../archivarix-external-images-importer.php:1260, ../archivarix-external-images-importer.php:1333
msgid "Web Archive unavailable (500 error)"
msgstr "Веб-Архив недоступен (ошибка 500)"

#. translators: %d: current retry attempt number (1-3).
#: ../archivarix-external-images-importer.php:1274
msgid "Web Archive rate limit (429). Retry %d/3 after delay."
msgstr "Лимит Веб-Архива (429). Попытка %d/3 после задержки."

#: ../archivarix-external-images-importer.php:1281, ../archivarix-external-images-importer.php:1339
msgid "Web Archive blocked - too many requests"
msgstr "Веб-Архив заблокирован — слишком много запросов"

#: ../archivarix-external-images-importer.php:1405
msgid ""
"Web Archive is unavailable (500 Internal Server Error). Downloads will continue "
"from original sources only."
msgstr ""
"Веб-Архив недоступен (ошибка 500). Загрузка продолжится только из оригинальных "
"источников."

#. translators: %d: current retry attempt number (1-3)
#: ../archivarix-external-images-importer.php:1409
msgid "Web Archive rate limit hit (429). Retry %d/3. Next attempt will be delayed."
msgstr ""
"Превышен лимит запросов к Веб-Архиву (429). Попытка %d/3. Следующий запрос будет"
" отложен."

#: ../archivarix-external-images-importer.php:1411
msgid ""
"Web Archive blocked due to too many requests (429). Downloads will continue from"
" original sources only."
msgstr ""
"Веб-Архив заблокирован из-за слишком большого количества запросов (429). "
"Загрузка продолжится только из оригинальных источников."

#: ../archivarix-external-images-importer.php:2050
msgid "Permission denied"
msgstr "Доступ запрещён"

#: ../archivarix-external-images-importer.php:2056
msgid "No logs to download"
msgstr "Нет логов для скачивания"

#. translators: %d: number of minutes between cron runs
#: ../includes/class-aeii-background-process.php:440
msgid "Every %d Minutes"
msgstr "Каждые %d минут"

